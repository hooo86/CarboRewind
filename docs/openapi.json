                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Verify",
        "tags": [
          "audit"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Open a session. Sets an HttpOnly session cookie and a CSRF cookie.",
        "operationId": "login_api_auth_login_post",
