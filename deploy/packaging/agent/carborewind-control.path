[Unit]
Description=CarboRewind: watch for a Carbonio start asked by the agent
Documentation=https://github.com/hooo86/CarboRewind/blob/main/docs/monitoring.md

[Path]
# Written by the (unprivileged) agent when Carbonio stays down; applied as root.
PathChanged=/var/lib/carborewind/control/request.json
Unit=carborewind-control.service

[Install]
WantedBy=multi-user.target
