[Unit]
Description=CarboRewind: start Carbonio (zmcontrol start) when the agent asks
Documentation=https://github.com/hooo86/CarboRewind/blob/main/docs/monitoring.md

[Service]
Type=oneshot
# Root is needed to run zmcontrol as zextras. The request is validated again here: only
# "start" is accepted and the command run is fixed; refused while apt / dpkg runs.
ExecStart=/usr/bin/carborewind-agent control apply
UMask=0077
PrivateTmp=yes
TimeoutStartSec=1000
