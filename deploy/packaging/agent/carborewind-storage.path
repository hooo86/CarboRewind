[Unit]
Description=CarboRewind: watch for storage settings from the web interface
Documentation=https://github.com/hooo86/CarboRewind/blob/main/docs/storage.md

[Path]
# Written by the (unprivileged) agent; applied by carborewind-storage.service as root.
PathChanged=/var/lib/carborewind/storage/request.json
Unit=carborewind-storage.service

[Install]
WantedBy=multi-user.target
