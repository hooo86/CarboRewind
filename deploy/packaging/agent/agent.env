# /etc/carborewind/agent.env — configuration de l'agent CarboRewind.
# Aucun secret ici : mots de passe et clés sont dans des fichiers 0600 (voir *_FILE).

# URL de l'API CarboRewind (obligatoire).
CARBOREWIND_AGENT_API_URL=https://carborewind.example.org
# CA du certificat HTTPS de l'API si elle est auto-signée (fournie par install-server.sh).
#CARBOREWIND_AGENT_API_CA_FILE=/etc/carborewind/api-ca.crt

# Compte administrateur Carbonio dédié à CarboRewind et fichier de son mot de passe (0600).
CARBOREWIND_AGENT_CARBONIO_ADMIN_NAME=carborewind@example.org
CARBOREWIND_AGENT_CARBONIO_ADMIN_PASSWORD_FILE=/etc/carborewind/carbonio-admin.password
# CA du certificat de Carbonio s'il est auto-signé (la vérification TLS n'est jamais désactivée).
#CARBOREWIND_AGENT_CARBONIO_CA_FILE=/etc/carborewind/carbonio-ca.crt
#CARBOREWIND_AGENT_SOAP_ADMIN_URL=https://localhost:7071/service/admin/soap
#CARBOREWIND_AGENT_MAILBOX_URL=https://localhost:443

# Dépôt de sauvegarde (disque local ou point de montage NFSv4) et sa clé (KEK, 0600).
CARBOREWIND_AGENT_REPOSITORY_PATH=/var/lib/carborewind/repository
CARBOREWIND_AGENT_REPOSITORY_KEY_FILE=/etc/carborewind/repository.key

# Certificat client mTLS obtenu par `carborewind-agent enroll`.
CARBOREWIND_AGENT_TLS_CERT=/var/lib/carborewind/tls/agent.crt
CARBOREWIND_AGENT_TLS_KEY=/var/lib/carborewind/tls/agent.key
CARBOREWIND_AGENT_TLS_CA=/var/lib/carborewind/tls/ca.crt

# Limitation de charge sur le serveur de messagerie.
CARBOREWIND_AGENT_MAX_CONCURRENT_ACCOUNTS=2
CARBOREWIND_AGENT_MAX_BANDWIDTH_MBPS=0
CARBOREWIND_AGENT_MAX_LOAD_PER_CPU=1.5
