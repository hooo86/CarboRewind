#!/bin/sh
set -e
if [ -d /run/systemd/system ] && [ "$1" = "remove" ]; then
    systemctl stop carborewind-agent.service || true
    systemctl disable carborewind-agent.service || true
    systemctl disable --now carborewind-storage.path || true
    systemctl disable --now carborewind-control.path || true
    systemctl disable --now carborewind-cert.path || true
fi
exit 0
