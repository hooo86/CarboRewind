# Copier vers deploy/.env (ignoré par Git) et remplacer TOUTES les valeurs.
# Copy to deploy/.env (git-ignored) and replace ALL values.
CARBOREWIND_ENVIRONMENT=development
CARBOREWIND_LOG_LEVEL=INFO
POSTGRES_DB=carborewind
POSTGRES_USER=carborewind
POSTGRES_PASSWORD=change-me

# --- Authentification LDAP Carbonio (facultatif). Laisser vide pour désactiver.
# CARBOREWIND_LDAP_BIND_PASSWORD : à injecter par l'orchestrateur (secret Docker / CI), jamais dans ce fichier.
CARBOREWIND_LDAP_URL=
CARBOREWIND_LDAP_START_TLS=false
CARBOREWIND_LDAP_CA_FILE=
CARBOREWIND_LDAP_BIND_DN=
CARBOREWIND_LDAP_USER_BASE=
